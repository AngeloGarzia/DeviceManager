# ============================================================
# EXEMPLE PROD gratuit (Render free + Aiven Free MySQL)
# ============================================================

APP_ENV=production
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

# Remplacer par les infos Aiven Free (SSL requis)
SPRING_DATASOURCE_URL=jdbc:mysql://HOST.a.aivencloud.com:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Schéma géré par Flyway uniquement — ne jamais utiliser update/create en prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

APP_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Access token court (15 min) ; APP_JWT_EXPIRATION_MS reste un alias rétrocompatible
APP_JWT_ACCESS_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_EXPIRATION_MS=900000

# Origine(s) exacte(s) du frontend — pas de wildcard *.onrender.com
# Exemple : https://device-manager-web.onrender.com
APP_CORS_ALLOWED_ORIGINS=https://device-manager-web.onrender.com
APP_CORS_ALLOW_DEV_LOCALHOST=false
APP_LOGIN_RATE_LIMIT_PER_MINUTE=20

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@devicemanager.local
APP_MAIL_ADMIN_EMAIL=admin@devicemanager.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Brevo: smtp-relay.brevo.com:587 + clé SMTP - activer via Setup ou APP_MAIL_ENABLED=true

APP_S3_ENABLED=false
APP_S3_BUCKET=
APP_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
APP_S3_LOCAL_FALLBACK_DIR=uploads

LOGGING_LEVEL_COM_DEVICEMANAGER=INFO

# Keep-alive Render free : ping /actuator/health toutes les 14 min (RENDER=true suffit sur Render)
# APP_KEEPALIVE_ENABLED=true
# APP_KEEPALIVE_URL=https://device-manager-api.onrender.com/actuator/health

# IA - seed / batterie ; config runtime aussi via Setup
APP_AI_ENABLED=false

# -- Batterie IA --
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
# Exemple Gemini :
# AI_DEFAULT_PROVIDER=gemini
# AI_DEFAULT_MODEL=gemini-2.0-flash
