# ============================================================
# EXEMPLE PROD / Render — ne pas committer les vrais secrets
# Sur Render, préférer les variables du Dashboard / render.yaml
# ============================================================

APP_ENV=production
# Render définit aussi PORT ; SERVER_PORT reste un fallback
SERVER_PORT=8080

# Interne Render (service privé device-manager-mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://device-manager-mysql:3306/device_manager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=device_manager
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

APP_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_EXPIRATION_MS=43200000

# URL publique du front static Render (CORS)
APP_CORS_ALLOWED_ORIGINS=https://device-manager-web.onrender.com

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@votredomaine.com
APP_MAIL_ADMIN_EMAIL=admin@votredomaine.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Photos : disque Render (/var/data/uploads) ou S3
APP_S3_ENABLED=false
APP_S3_BUCKET=
APP_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
APP_S3_LOCAL_FALLBACK_DIR=/var/data/uploads

LOGGING_LEVEL_COM_DEVICEMANAGER=INFO
