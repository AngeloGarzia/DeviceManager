# ============================================================
# EXEMPLE — copier vers .env.production et renseigner les secrets
# ============================================================

APP_ENV=production
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://DB_HOST:3306/device_manager?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

APP_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_EXPIRATION_MS=43200000

APP_CORS_ALLOWED_ORIGINS=https://app.votredomaine.com

APP_MAIL_ENABLED=true
APP_MAIL_FROM=noreply@votredomaine.com
APP_MAIL_ADMIN_EMAIL=admin@votredomaine.com
MAIL_HOST=smtp.votredomaine.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

APP_S3_ENABLED=true
APP_S3_BUCKET=device-manager-photos-prod
APP_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT=
APP_S3_LOCAL_FALLBACK_DIR=uploads

LOGGING_LEVEL_COM_DEVICEMANAGER=WARN
