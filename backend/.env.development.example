# APP_MAIL_FROM=ton-email-verifie@domaine.com
# APP_MAIL_ADMIN_EMAIL=admin@ton-domaine.com
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=ton-login-brevo
# MAIL_PASSWORD=ta-cle-smtp-brevo

# Exemple Gmail (mot de passe d'application requis)
# APP_MAIL_ENABLED=true
# APP_MAIL_FROM=ton.compte@gmail.com
# APP_MAIL_ADMIN_EMAIL=admin@ton-domaine.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=ton.compte@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

APP_S3_ENABLED=false
APP_S3_BUCKET=device-manager-photos
APP_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
APP_S3_LOCAL_FALLBACK_DIR=uploads

LOGGING_LEVEL_COM_DEVICEMANAGER=INFO
