# ============================================================
# EXEMPLE - copier vers .env.development
# ============================================================

APP_ENV=development
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/device_manager?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

APP_JWT_SECRET=DeviceManagerSecretKeyForJwtTokensMustBeLongEnough2026!
APP_JWT_EXPIRATION_MS=86400000

APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

APP_MAIL_ENABLED=false
APP_MAIL_FROM=noreply@devicemanager.local
APP_MAIL_ADMIN_EMAIL=admin@casino.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Exemple Brevo (gratuit) - https://app.brevo.com
# APP_MAIL_ENABLED=true
# APP_MAIL_FROM=ton-email-verifie@domaine.com
# APP_MAIL_ADMIN_EMAIL=admin@ton-domaine.com
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=ton-login-brevo
# MAIL_PASSWORD=ta-cle-smtp-brevo

# Exemple Gmail (mot de passe d'application requis)
# APP_MAIL_ENABLED=true
# APP_MAIL_FROM=ton.compte@gmail.com
# APP_MAIL_ADMIN_EMAIL=admin@ton-domaine.com
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=ton.compte@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

APP_S3_ENABLED=false
APP_S3_BUCKET=device-manager-photos
APP_S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
APP_S3_LOCAL_FALLBACK_DIR=uploads

LOGGING_LEVEL_COM_DEVICEMANAGER=INFO

# IA - valeurs initiales au premier démarrage uniquement
# Config runtime recommandée : Setup → Intelligence artificielle
# (AI_ENABLED / AI_PROVIDER / AI_MODEL / AI_API_KEY)
APP_AI_ENABLED=false
# openai | groq | mistral | openrouter | deepseek | together | fireworks
# (seed Setup AI_PROVIDER = openai si absent)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_API_KEY sert de seed pour AI_API_KEY (clé du fournisseur choisi dans Setup)
# Exemples de clés selon fournisseur :
# - OpenAI     : sk-...
# - Groq       : gsk_...
# - Mistral    : ...
# - OpenRouter : sk-or-...
# - DeepSeek   : sk-...
# - Together   : ...
# - Fireworks  : ...
