<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      Suppressions OWASP Dependency-Check (failBuildOnCVSS=7).
      Critères : faux positif CPE, prérequis non utilisés dans DeviceManager,
      ou correctif OSS indisponible sur Spring Boot 3.5 (patch Enterprise only).
      Revoir à chaque montée Boot / Spring AI.
    -->

    <!-- CVE Kotlin build-cache (kotlin-gradle-plugin), pas le runtime kotlin-stdlib/reflect. -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-53914 : désérialisation unsafe du build cache Kotlin (kotlin-gradle-plugin).
            DeviceManager n'utilise pas le plugin Kotlin Gradle ; kotlin-stdlib / reflect sont des
            dépendances transitives runtime (Spring AI / openai-java). Faux positif CPE.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-(stdlib.*|reflect)@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

    <!-- CVE Python protobuf, matché à tort sur protobuf-java. -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-0994 : DoS dans google.protobuf.json_format (Python).
            Ne concerne pas com.google.protobuf:protobuf-java. Faux positif CPE.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java@.*$</packageUrl>
        <cve>CVE-2026-0994</cve>
    </suppress>

    <!-- Spring Framework SSE — DeviceManager n'expose pas SSE / fragments. -->
    <suppress>
        <notes><![CDATA[
            CVE Spring Framework SSE / fragments (CVE-2026-59313, 47890–47893, 59282–59283).
            Correctif OSS : Framework 7.0.9 (Boot 4) ; 6.2.20 = Enterprise only.
            Non applicable : pas d'endpoints SSE ni de streaming de fragments.
            À retirer après migration Spring Boot 4 / Framework 7.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-59313</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-47890</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-47891</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-47892</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-47893</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-59282</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-59313 — SSE non utilisé.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(core|web|webmvc|webflux)@.*$</packageUrl>
        <cve>CVE-2026-59283</cve>
    </suppress>

    <!-- Spring Security LDAP UnboundID — non utilisé. -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-59270 : UnboundIdContainer (LDAP embarqué) bind toutes interfaces.
            DeviceManager n'utilise pas Spring LDAP / UnboundID. Correctif 6.5.12 Enterprise only.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring-security-(core|web|config|crypto)@.*$</packageUrl>
        <cve>CVE-2026-59270</cve>
    </suppress>

    <!-- Spring Security WebAuthn — non utilisé. -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-47841 : bypass WebAuthn userVerification avec session distribuée.
            DeviceManager utilise JWT stateless, pas WebAuthn ni Spring Session. 6.5.12 Enterprise only.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring-security-(core|web|config)@.*$</packageUrl>
        <cve>CVE-2026-47841</cve>
    </suppress>

    <!-- Spring AI ONNX cache local — non utilisé (OpenAI / Gemini HTTP). -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-47852 / 47851 / 47835 / 59294 / 59319 : cache ONNX / modèles locaux.
            DeviceManager n'utilise pas de modèles ONNX locaux (chat OpenAI/Gemini via API).
            Patch partiel en 2.0.1 ; conserver tant que CPE match encore.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.ai/spring-ai-.*@.*$</packageUrl>
        <cve>CVE-2026-47852</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Voir notes CVE-2026-47852 — pas d'ONNX local.]]></notes>
