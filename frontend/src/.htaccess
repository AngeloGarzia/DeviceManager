RewriteEngine On

# Documents HTML / entrée SPA : jamais de cache (évite un ancien shell après deploy).
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Si le fichier ou dossier demandé existe, on le sert tel quel
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sinon, on renvoie index.html (Angular lit l'URL ensuite)
RewriteRule ^ /index.html [L]
